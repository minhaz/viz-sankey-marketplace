{
  "compilerOptions": {
    "module": "es6",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "allowJs": true,
    "esModuleInterop": true,
    "outDir": "lib",
    "strict": true,
    "lib": [
      "dom",
      "es6",
      "es2015.collection"
    ],
    "target": "es5"
  },
  "exclude": [
    "node_modules"
  ],
  "rootDir": [
    "src/"
  ]
}
